<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 这个游戏的 Assembly-CSharp 是 .NET 4.x / netstandard2.0，不能使用 net35 -->
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>ProblyStolen_friendwine</AssemblyName>
		<RootNamespace>DeepSpacePawnshop</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<!-- 如果游戏目录变化，只需要改这里 -->
		<GameDir>F:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
		<MelonLoaderDir>$(GameDir)\MelonLoader\net472</MelonLoaderDir>
		<ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
						  Version="1.0.3"
						  PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="MelonLoader">
			<HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="0Harmony">
			<HintPath>$(MelonLoaderDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
